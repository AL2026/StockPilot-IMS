@model InventoryManagementSystem.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Edit Product</h1>
    <p class="text-muted mb-0">Update this product's details.</p>
</div>

<div class="card section-card form-card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="ProductId" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="Price"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Current Quantity</label>
                    <input type="text" class="form-control" value="@Model.Quantity" disabled />
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>Quantity can't be edited directly. Record a <a asp-controller="Purchases" asp-action="Create">Purchase</a> to add stock or a <a asp-controller="Sales" asp-action="Create">Sale</a> to remove it.
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="CategoryId"></span>
            </div>
            <div class="mb-4">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId"></select>
                <span asp-validation-for="SupplierId"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
