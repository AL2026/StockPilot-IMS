@model InventoryManagementSystem.Models.Product

@{
    ViewData["Title"] = "New Product";
}

<div class="mb-4">
    <h1 class="h3 mb-1">New Product</h1>
    <p class="text-muted mb-0">Add a product to your catalog.</p>
</div>

<div class="card section-card form-card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Wireless Mouse" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2" placeholder="Optional description"></textarea>
                <span asp-validation-for="Description"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Price"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Starting Quantity</label>
                    <input type="text" class="form-control" value="0" disabled />
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>New products always start at 0. Record a Purchase after saving to add stock.
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId"></span>
            </div>
            <div class="mb-4">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId">
                    <option value="">-- Select Supplier --</option>
                </select>
                <span asp-validation-for="SupplierId"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Create
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
