@model InventoryManagementSystem.Models.ViewModels.SalesReportViewModel

@{
    ViewData["Title"] = "Sales Report";
    var totalTransactions = Model.Sales.Count;
    var averageSale = totalTransactions > 0 ? Model.Sales.Average(s => s.SalePrice * s.Quantity) : 0;
    var highestSale = totalTransactions > 0 ? Model.Sales.Max(s => s.SalePrice * s.Quantity) : 0;
    var lowestSale = totalTransactions > 0 ? Model.Sales.Min(s => s.SalePrice * s.Quantity) : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Sales Report</h1>
        <p class="text-muted mb-0">Revenue and transaction breakdown for a chosen period.</p>
    </div>
    <a asp-action="ExportSalesReportCsv" asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">
        <i class="bi bi-download me-1"></i>Export CSV
    </a>
</div>

<div class="card section-card mb-4">
    <div class="card-body">
        <form asp-action="SalesReport" method="get" id="reportFilterForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Start Date</label>
                    <input type="date" id="startDate" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">End Date</label>
                    <input type="date" id="endDate" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                    <a asp-action="SalesReport" class="btn btn-outline-secondary flex-fill">Reset</a>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-sm btn-outline-secondary quick-range" data-days="0">Today</button>
                <button type="button" class="btn btn-sm btn-outline-secondary quick-range" data-days="7">Last 7 Days</button>
                <button type="button" class="btn btn-sm btn-outline-secondary quick-range" data-days="30">Last 30 Days</button>
                <button type="button" class="btn btn-sm btn-outline-secondary quick-range" data-days="365">This Year</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card bg-gradient-green">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Total Revenue</div>
                    <div class="stat-value">$@Model.TotalRevenue.ToString("N2")</div>
                </div>
                <i class="bi bi-cash-coin stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card bg-gradient-indigo">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Transactions</div>
                    <div class="stat-value">@totalTransactions</div>
                </div>
                <i class="bi bi-receipt stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card bg-gradient-sky">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Average Sale</div>
                    <div class="stat-value">$@averageSale.ToString("N2")</div>
                </div>
                <i class="bi bi-bar-chart stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card bg-gradient-amber">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Highest / Lowest</div>
                    <div class="stat-value fs-6">$@highestSale.ToString("N2") / $@lowestSale.ToString("N2")</div>
                </div>
                <i class="bi bi-arrow-down-up stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="card section-card">
    <div class="card-body p-0">
        @if (Model.Sales.Any())
        {
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Sale Price</th>
                        <th class="text-end">Total</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sale in Model.Sales)
                    {
                        <tr>
                            <td>@sale.Product?.Name</td>
                            <td class="text-end">
                                <span class="badge badge-soft-success">@sale.Quantity</span>
                            </td>
                            <td class="text-end">$@sale.SalePrice.ToString("N2")</td>
                            <td class="text-end fw-semibold">$@((sale.SalePrice * sale.Quantity).ToString("N2"))</td>
                            <td class="text-muted">@sale.SaleDate.ToShortDateString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-cash-coin"></i>
                No sales found for this period.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.quick-range').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const days = parseInt(btn.dataset.days, 10);
                const end = new Date();
                const start = new Date();
                start.setDate(end.getDate() - days);
                document.getElementById('startDate').value = start.toISOString().slice(0, 10);
                document.getElementById('endDate').value = end.toISOString().slice(0, 10);
                document.getElementById('reportFilterForm').submit();
            });
        });
    </script>
}
