@model InventoryManagementSystem.Models.ViewModels.ProfitReportViewModel

@{
    ViewData["Title"] = "Profit Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Profit Report</h1>
        <p class="text-muted mb-0">Revenue, cost and margin by product.</p>
    </div>
    <a asp-action="ExportProfitReportCsv" class="btn btn-outline-secondary">
        <i class="bi bi-download me-1"></i>Export CSV
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card bg-gradient-green">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Total Revenue</div>
                    <div class="stat-value">$@Model.TotalRevenue.ToString("N2")</div>
                </div>
                <i class="bi bi-graph-up-arrow stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-gradient-rose">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Total Cost</div>
                    <div class="stat-value">$@Model.TotalCost.ToString("N2")</div>
                </div>
                <i class="bi bi-cart-plus stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-gradient-indigo">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Total Profit</div>
                    <div class="stat-value">$@Model.TotalProfit.ToString("N2")</div>
                </div>
                <i class="bi bi-piggy-bank stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="card section-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clipboard-data me-2"></i>Product Profit Details</span>
        <div class="btn-group">
            <button type="button" class="btn btn-sm btn-outline-secondary profit-filter active" data-filter="all">All</button>
            <button type="button" class="btn btn-sm btn-outline-secondary profit-filter" data-filter="loss">Losses Only</button>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.Products.Any())
        {
            <table class="table table-hover mb-0 align-middle" id="profitTable">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Quantity Sold</th>
                        <th class="text-end">Revenue</th>
                        <th class="text-end">Cost</th>
                        <th class="text-end">Profit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Products)
                    {
                        var isLoss = item.Profit < 0;
                        <tr data-loss="@isLoss.ToString().ToLower()">
                            <td>@item.ProductName</td>
                            <td class="text-end">@item.QuantitySold</td>
                            <td class="text-end">$@item.Revenue.ToString("N2")</td>
                            <td class="text-end">$@item.Cost.ToString("N2")</td>
                            <td class="text-end">
                                @if (item.Profit >= 0)
                                {
                                    <span class="badge bg-success">$@item.Profit.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">$@item.Profit.ToString("N2")</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="noProfitResults" class="empty-state d-none">
                <i class="bi bi-emoji-smile"></i>
                No losses found — every product is profitable.
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-piggy-bank"></i>
                No sales data to report on yet.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const profitButtons = document.querySelectorAll('.profit-filter');
        const profitRows = document.querySelectorAll('#profitTable tbody tr');
        const noProfitResults = document.getElementById('noProfitResults');

        profitButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                profitButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const filter = btn.dataset.filter;
                let visibleCount = 0;

                profitRows.forEach(function (row) {
                    const isLoss = row.dataset.loss === 'true';
                    const show = filter === 'all' || (filter === 'loss' && isLoss);
                    row.classList.toggle('d-none', !show);
                    if (show) visibleCount++;
                });

                if (noProfitResults) {
                    noProfitResults.classList.toggle('d-none', visibleCount > 0);
                }
            });
        });
    </script>
}
