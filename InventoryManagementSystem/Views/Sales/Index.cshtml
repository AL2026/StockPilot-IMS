@model IEnumerable<InventoryManagementSystem.Models.Sale>

@{
    ViewData["Title"] = "Sales";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Sales Manager");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Sales</h1>
        <p class="text-muted mb-0">Stock-out transactions to your customers.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Sale
        </a>
    }
</div>

<div class="card section-card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Sale Price</th>
                        <th class="text-end">Total</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.Product?.Name ?? "No Product")</td>
                            <td class="text-end">
                                <span class="badge badge-soft-success">@item.Quantity</span>
                            </td>
                            <td class="text-end">$@item.SalePrice.ToString("N2")</td>
                            <td class="text-end fw-semibold">$@((item.SalePrice * item.Quantity).ToString("N2"))</td>
                            <td class="text-muted">@item.SaleDate.ToShortDateString()</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.SaleId" class="btn btn-sm btn-outline-secondary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (canManage)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.SaleId" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-id="@item.SaleId" data-name="@($"{item.Quantity}x {item.Product?.Name ?? "No Product"}")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-cash-coin"></i>
                No sales recorded yet.
            </div>
        }
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete Sale</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this sale: <strong id="deleteItemName"></strong>? This can't be undone — the sold quantity will be returned to stock.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('deleteItemName').textContent = button.getAttribute('data-name');
            document.getElementById('deleteForm').action = '/Sales/Delete/' + button.getAttribute('data-id');
        });
    </script>
}
