@model InventoryManagementSystem.Models.Sale

@{
    ViewData["Title"] = "Edit Sale";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Edit Sale</h1>
    <p class="text-muted mb-0">Update this sale. Stock will be adjusted automatically.</p>
</div>

<div class="card section-card form-card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="SaleId" />
            <div class="mb-3">
                <label asp-for="ProductId" class="form-label"></label>
                <select asp-for="ProductId" class="form-select" id="productSelect">
                    @foreach (var product in (List<InventoryManagementSystem.Models.Product>)ViewBag.Products)
                    {
                        <option value="@product.ProductId" data-price="@product.Price.ToString("F2")" selected="@(product.ProductId == Model.ProductId ? "selected" : null)">@product.Name</option>
                    }
                </select>
                <span asp-validation-for="ProductId"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Quantity"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SalePrice" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="SalePrice" id="SalePrice" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="SalePrice"></span>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="SaleDate" class="form-label"></label>
                <input asp-for="SaleDate" type="date" class="form-control" />
                <span asp-validation-for="SaleDate"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Only auto-fills when the user actively changes the product — the price
        // this sale was originally recorded at is left alone on page load.
        document.getElementById('productSelect').addEventListener('change', function () {
            var selected = this.options[this.selectedIndex];
            var price = selected.getAttribute('data-price');
            if (price) {
                document.getElementById('SalePrice').value = price;
            }
        });
    </script>
}
