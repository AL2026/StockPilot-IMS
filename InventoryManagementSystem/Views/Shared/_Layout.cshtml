<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockPilot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InventoryManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

        // Was previously a hardcoded Admin/Staff check that ignored every other role
        // (Inventory Manager, Purchase Manager, Sales Manager all displayed as "Staff"
        // even though their actual permissions were correct). This checks each real
        // role name so the badge always matches what's actually assigned.
        var displayRole = User.IsInRole("Admin") ? "Admin"
        : User.IsInRole("Inventory Manager") ? "Inventory Manager"
        : User.IsInRole("Purchase Manager") ? "Purchase Manager"
        : User.IsInRole("Sales Manager") ? "Sales Manager"
        : "Staff";
    }

    <button type="button" id="mobileSidebarToggle" class="mobile-sidebar-toggle d-lg-none" aria-label="Open menu">
        <i class="bi bi-list"></i>
    </button>

    <div class="app-shell">
        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-boxes"></i>
                    <span class="sidebar-brand-text">StockPilot</span>
                </a>
                <button type="button" id="sidebarCollapseToggle" class="sidebar-collapse-btn d-none d-lg-inline-flex" title="Collapse sidebar" aria-label="Collapse sidebar">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>

            <nav class="sidebar-nav">
                <a class="sidebar-link @(currentController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index" title="Dashboard">
                    <i class="bi bi-speedometer2"></i><span class="sidebar-link-text">Dashboard</span>
                </a>
                <a class="sidebar-link @(currentController == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index" title="Products">
                    <i class="bi bi-box-seam"></i><span class="sidebar-link-text">Products</span>
                </a>
                <a class="sidebar-link @(currentController == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index" title="Categories">
                    <i class="bi bi-tags"></i><span class="sidebar-link-text">Categories</span>
                </a>
                <a class="sidebar-link @(currentController == "Suppliers" ? "active" : "")" asp-controller="Suppliers" asp-action="Index" title="Suppliers">
                    <i class="bi bi-truck"></i><span class="sidebar-link-text">Suppliers</span>
                </a>
                <a class="sidebar-link @(currentController == "Purchases" ? "active" : "")" asp-controller="Purchases" asp-action="Index" title="Purchases">
                    <i class="bi bi-cart-plus"></i><span class="sidebar-link-text">Purchases</span>
                </a>
                <a class="sidebar-link @(currentController == "Sales" ? "active" : "")" asp-controller="Sales" asp-action="Index" title="Sales">
                    <i class="bi bi-cash-coin"></i><span class="sidebar-link-text">Sales</span>
                </a>

                <div class="sidebar-group @(currentController == "Reports" ? "open" : "")">
                    <button type="button" class="sidebar-group-toggle @(currentController == "Reports" ? "active" : "")" title="Reports">
                        <i class="bi bi-bar-chart-line"></i><span class="sidebar-link-text">Reports</span>
                        <i class="bi bi-chevron-down sidebar-caret"></i>
                    </button>
                    <div class="sidebar-submenu">
                        <a class="sidebar-sublink" asp-controller="Reports" asp-action="SalesReport"><i class="bi bi-graph-up-arrow"></i><span class="sidebar-link-text">Sales Report</span></a>
                        <a class="sidebar-sublink" asp-controller="Reports" asp-action="PurchaseReport"><i class="bi bi-bag-check"></i><span class="sidebar-link-text">Purchase Report</span></a>
                        <a class="sidebar-sublink" asp-controller="Reports" asp-action="InventoryReport"><i class="bi bi-clipboard-data"></i><span class="sidebar-link-text">Inventory Report</span></a>
                        <a class="sidebar-sublink" asp-controller="Reports" asp-action="ProfitReport"><i class="bi bi-piggy-bank"></i><span class="sidebar-link-text">Profit Report</span></a>
                    </div>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <a class="sidebar-link @(currentController == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index" title="Users">
                        <i class="bi bi-people"></i><span class="sidebar-link-text">Users</span>
                    </a>
                }

                <a class="sidebar-link" asp-controller="Home" asp-action="Privacy" title="Privacy">
                    <i class="bi bi-shield-lock"></i><span class="sidebar-link-text">Privacy</span>
                </a>
            </nav>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="main-content">
            <div class="topbar">
                <div class="account-widget">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="account-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="account-avatar"><i class="bi bi-person-fill"></i></span>
                                <span class="account-email d-none d-sm-inline">@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li class="px-3 py-1 d-flex justify-content-between align-items-center">
                                    <span class="text-muted small text-truncate">@User.Identity.Name</span>
                                    <span class="badge @(User.IsInRole("Admin") ? "bg-primary" : "bg-secondary") ms-2">
                                        @displayRole
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-circle me-2"></i>Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li class="px-3 pb-2">
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                            <i class="bi bi-box-arrow-right me-1"></i>Log Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-primary">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Log In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-outline-primary bg-white">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="page-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>

            <footer class="app-footer">
                <table class="table mb-0 border-top">
                    <tbody>
                        <tr>
                            <td class="text-muted align-middle border-0">&copy; @DateTime.Now.Year - StockPilot Inventory System</td>
                            <td class="text-end align-middle border-0">
                                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var sidebar = document.getElementById('appSidebar');
            var collapseBtn = document.getElementById('sidebarCollapseToggle');
            var mobileToggle = document.getElementById('mobileSidebarToggle');
            var backdrop = document.getElementById('sidebarBackdrop');

            // Restore the collapsed/expanded preference from the last visit.
            if (localStorage.getItem('sidebarCollapsed') === 'true') {
                sidebar.classList.add('collapsed');
            }

            if (collapseBtn) {
                collapseBtn.addEventListener('click', function () {
                    sidebar.classList.toggle('collapsed');
                    localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
                });
            }

            if (mobileToggle) {
                mobileToggle.addEventListener('click', function () {
                    sidebar.classList.toggle('mobile-open');
                    backdrop.classList.toggle('show');
                });
            }

            if (backdrop) {
                backdrop.addEventListener('click', function () {
                    sidebar.classList.remove('mobile-open');
                    backdrop.classList.remove('show');
                });
            }

            document.querySelectorAll('.sidebar-group-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var group = btn.closest('.sidebar-group');

                    if (sidebar.classList.contains('collapsed')) {
                        // Submenus can't show while collapsed (icon-only mode), so expand
                        // the sidebar first, then open this submenu - rather than doing
                        // nothing at all like it did before.
                        sidebar.classList.remove('collapsed');
                        localStorage.setItem('sidebarCollapsed', 'false');
                        group.classList.add('open');
                    } else {
                        group.classList.toggle('open');
                    }
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
