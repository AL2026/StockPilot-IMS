@model InventoryManagementSystem.Controllers.VerifyEmailViewModel

@{
    ViewData["Title"] = "Verify Your Email";
    Layout = "_AuthLayout";
}

<div class="d-flex justify-content-center">
    <div class="card section-card form-card w-100" style="max-width: 420px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-envelope-check fs-1 text-primary"></i>
                <h1 class="h4 mt-2 mb-0">Verify your email</h1>
                <p class="text-muted small mb-0">
                    We sent a 5-digit code to <strong>@Model.Email</strong>. It expires in 15 minutes.
                </p>
            </div>

            <form asp-action="VerifyEmail">
                <div asp-validation-summary="ModelOnly"></div>
                <input type="hidden" asp-for="Email" />
                <div class="mb-4">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control text-center" style="letter-spacing: 6px; font-size: 1.25rem;" maxlength="5" inputmode="numeric" pattern="\d{5}" placeholder="00000" autofocus />
                    <span asp-validation-for="Code"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-check-lg me-1"></i>Verify Account
                </button>
            </form>

            <form asp-action="ResendVerificationCode" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@Model.Email" />
                <button type="submit" class="btn btn-link w-100 text-decoration-none small">
                    Didn't get a code? Resend it
                </button>
            </form>

            <p class="text-center text-muted small mt-2 mb-0">
                <a asp-action="Login"><i class="bi bi-arrow-left me-1"></i>Back to log in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
