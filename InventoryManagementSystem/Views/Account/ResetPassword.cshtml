@model InventoryManagementSystem.Controllers.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="d-flex justify-content-center">
    <div class="card section-card form-card w-100" style="max-width: 420px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-shield-check fs-1 text-primary"></i>
                <h1 class="h4 mt-2 mb-0">Enter your reset code</h1>
                <p class="text-muted small mb-0">Check your email for the 5-digit code. It expires in 15 minutes.</p>
            </div>

            <form asp-action="ResetPassword">
                <div asp-validation-summary="ModelOnly"></div>
                <input type="hidden" asp-for="Email" />
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="text" class="form-control" value="@Model.Email" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control text-center" style="letter-spacing: 6px; font-size: 1.25rem;" maxlength="5" inputmode="numeric" pattern="\d{5}" placeholder="00000" autofocus />
                    <span asp-validation-for="Code"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" placeholder="At least 6 characters" />
                    <span asp-validation-for="NewPassword"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-check-lg me-1"></i>Reset Password
                </button>
            </form>

            <p class="text-center text-muted small mt-4 mb-0">
                Didn't get a code? <a asp-action="ForgotPassword">Request a new one</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
