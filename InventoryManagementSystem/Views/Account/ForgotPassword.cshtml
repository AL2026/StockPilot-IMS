@model InventoryManagementSystem.Controllers.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="d-flex justify-content-center">
    <div class="card section-card form-card w-100" style="max-width: 420px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-key fs-1 text-primary"></i>
                <h1 class="h4 mt-2 mb-0">Forgot your password?</h1>
                <p class="text-muted small mb-0">We'll email you a 5-digit code to reset it.</p>
            </div>

            <form asp-action="ForgotPassword">
                <div asp-validation-summary="ModelOnly"></div>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" autofocus />
                    <span asp-validation-for="Email"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-send me-1"></i>Send Reset Code
                </button>
            </form>

            <p class="text-center text-muted small mt-4 mb-0">
                <a asp-action="Login"><i class="bi bi-arrow-left me-1"></i>Back to log in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
