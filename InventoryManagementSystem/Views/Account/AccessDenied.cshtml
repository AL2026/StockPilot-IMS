@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="d-flex justify-content-center">
    <div class="card section-card form-card w-100 text-center" style="max-width: 420px;">
        <div class="card-body p-4">
            <i class="bi bi-shield-lock fs-1 text-danger"></i>
            <h1 class="h4 mt-2 mb-2">Access Denied</h1>
            <p class="text-muted mb-4">You don't have permission to do that. This action requires an Admin account.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house me-1"></i>Back to Home
            </a>
        </div>
    </div>
</div>
