@{
    ViewData["Title"] = "Home";
}

<div class="hero-section mb-5">
    <i class="bi bi-boxes hero-icon d-block"></i>
    <h1 class="display-6 fw-bold mb-2">Welcome to StockPilot</h1>
    <p class="mb-4">
        Track products, manage suppliers, record purchases and sales, and keep an eye
        on your inventory health — all in one place.
    </p>
    <div class="d-flex justify-content-center gap-2 flex-wrap">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-lg">
            <i class="bi bi-speedometer2 me-1"></i>Go to Dashboard
        </a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-light btn-lg">
            <i class="bi bi-box-seam me-1"></i>View Products
        </a>
    </div>
</div>

<div class="mb-5">
    <h2 class="h4 text-center mb-4">How Inventory Flows</h2>
    <div class="row align-items-center justify-content-center g-3 text-center">
        <div class="col-6 col-md-3">
            <div class="step-icon bg-gradient-indigo">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="fw-semibold">1. Create a Product</div>
            <div class="text-muted small">Starts at 0 stock</div>
        </div>
        <div class="col-auto d-none d-md-block">
            <i class="bi bi-arrow-right step-arrow"></i>
        </div>
        <div class="col-6 col-md-3">
            <div class="step-icon bg-gradient-violet">
                <i class="bi bi-cart-plus"></i>
            </div>
            <div class="fw-semibold">2. Record a Purchase</div>
            <div class="text-muted small">Adds stock automatically</div>
        </div>
        <div class="col-auto d-none d-md-block">
            <i class="bi bi-arrow-right step-arrow"></i>
        </div>
        <div class="col-6 col-md-3">
            <div class="step-icon bg-gradient-green">
                <i class="bi bi-cash-coin"></i>
            </div>
            <div class="fw-semibold">3. Record a Sale</div>
            <div class="text-muted small">Removes stock automatically</div>
        </div>
    </div>
</div>

<div>
    <h2 class="h4 mb-3">Quick Access</h2>
    <div class="row g-3">
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Dashboard" asp-action="Index" class="card quick-link-card h-100 text-decoration-none">
                <div class="card-body text-center">
                    <div class="quick-link-icon bg-gradient-indigo mx-auto mb-2">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <div class="fw-semibold text-body">Dashboard</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Products" asp-action="Index" class="card quick-link-card h-100 text-decoration-none">
                <div class="card-body text-center">
                    <div class="quick-link-icon bg-gradient-sky mx-auto mb-2">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="fw-semibold text-body">Products</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Categories" asp-action="Index" class="card quick-link-card h-100 text-decoration-none">
                <div class="card-body text-center">
                    <div class="quick-link-icon bg-gradient-teal mx-auto mb-2">
                        <i class="bi bi-tags"></i>
                    </div>
                    <div class="fw-semibold text-body">Categories</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Suppliers" asp-action="Index" class="card quick-link-card h-100 text-decoration-none">
                <div class="card-body text-center">
                    <div class="quick-link-icon bg-gradient-amber mx-auto mb-2">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div class="fw-semibold text-body">Suppliers</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Purchases" asp-action="Index" class="card quick-link-card h-100 text-decoration-none">
                <div class="card-body text-center">
                    <div class="quick-link-icon bg-gradient-violet mx-auto mb-2">
                        <i class="bi bi-cart-plus"></i>
                    </div>
                    <div class="fw-semibold text-body">Purchases</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Sales" asp-action="Index" class="card quick-link-card h-100 text-decoration-none">
                <div class="card-body text-center">
                    <div class="quick-link-icon bg-gradient-green mx-auto mb-2">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div class="fw-semibold text-body">Sales</div>
                </div>
            </a>
        </div>
    </div>
</div>
