@model InventoryManagementSystem.Models.Purchase

@{
    ViewData["Title"] = "Edit Purchase";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Edit Purchase</h1>
    <p class="text-muted mb-0">Update quantity, price, or date for this purchase.</p>
</div>

<div class="card section-card form-card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="PurchaseId" />
            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" asp-for="SupplierId" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Product</label>
                    <input class="form-control" value="@Model.Product?.Name" readonly />
                    <div class="form-text">Product can't be changed after a purchase is recorded.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Supplier</label>
                    <input class="form-control" value="@Model.Supplier?.Name" readonly />
                    <div class="form-text">Supplier can't be changed after a purchase is recorded.</div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Quantity"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PurchasePrice" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PurchasePrice" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="PurchasePrice"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="PurchaseDate" class="form-label"></label>
                <input asp-for="PurchaseDate" type="date" class="form-control" />
                <span asp-validation-for="PurchaseDate"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
